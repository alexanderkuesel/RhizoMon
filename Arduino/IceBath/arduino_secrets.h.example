// Copy this file to "arduino_secrets.h" (same folder) and fill in your
// real network credentials. arduino_secrets.h is listed in .gitignore
// so your credentials never get committed.

#define SECRET_SSID "YourWiFiSSID"
#define SECRET_PASS "YourWiFiPassword"

// Password for over-the-air sketch uploads. The Arduino IDE prompts for
// this on every OTA upload. Anything on your network can reach the OTA
// port, so do not leave this as the placeholder.
#define SECRET_OTA_PASS "ChangeThisOtaPassword"
